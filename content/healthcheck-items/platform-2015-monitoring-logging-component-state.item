version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Monitoring & Logging"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Observability"
    - "Security"
  description: "OpenShift logging status"
  references: 
  - title: "OpenShift logging status"
    url: "https://docs.openshift.com/container-platform/latest/logging/troubleshooting/cluster-logging-cluster-status.html"
  - title: "OpenShift Loki"
    url: "https://docs.openshift.com/container-platform/latest/observability/network_observability/installing-operators.html#network-observability-loki-installation_network_observability"
  check_procedures:
    - type: "survey"
      question: "Is the logging operator reporting any issues?"
    - type: "command"
      question: ""
      command: |
        # 'Review the output under "status" for fluentd pods, logstore and visualization. Take note of any components in a not-ready status and details around the condition messages'
        oc get clusterlogging instance -n openshift-logging -o yaml
        oc get clusterlogforwarder -n openshift-logging -o yaml

        # 'Review the output of the operator and the associated replicaset for errors'
        oc get deployment cluster-logging-operator -n openshift-logging -o yaml
        oc get replicaset -n openshift-logging

        # 'Take note of the pod names and use in the command below'
        oc get pods -n openshift-logging

        # 'Review the events in namespace "openshift-logging"'
        oc get events -n openshift-logging|grep -v Normal
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "El estado del stack de Logging es verde"
    description_long_text: "El estado de salud del stack de OpenShift Logging es verde. Sin embargo falta llevarlo completamente a la ultima version y desprenderse del ElasticSearch."
    impact_and_risk_text: ""
    remediation_text: "Se recomienda terminar de actualizar el stack de Logging una vez actualizado el Openshift a version 4.16 y dar de baja al ElasticSearch"
  - key: "changes_required01"
    scenario_description_short_text: "Problemas en el stack de Logging (tolerations de infra)"
    description_long_text: "Se encontró un problema en el stack de Logging debido a que los collectors no levantaron en los nodos infra. Podrían estar faltando tolerations para permitir su ejecución en dichos nodos."
    impact_and_risk_text: "La falta de collectors en los nodos infra puede provocar una recolección incompleta de logs y la pérdida de información de auditoría y troubleshooting."
    remediation_text: "Revisar la configuración del stack de Logging y validar que los collectors cuenten con las tolerations necesarias para ejecutarse en los nodos infra."
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: changes_recommended
  common_outcome_key: "changes_required01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
  outcome_evidence: |
    [guillermo@darkstar paas-apps1-prdpg]$ omc get csv -A --no-headers | awk '{print $2}' | sort -u
    3scale-operator.v0.13.4
    apicast-operator.v0.13.4
    cert-manager-operator.v1.18.1
    cluster-logging.v6.5.1
    openshift-external-secrets-operator.v1.2.0
    packageserver

    ---

    [guillermo@darkstar paas-apps1-prdpg]$ omc get sub -A
    NAMESPACE                             NAME                                  PACKAGE                               SOURCE             CHANNEL
    amp                                   3scale-operator                       3scale-operator                       redhat-operators   threescale-2.16
    amp                                   apicast-operator                      apicast-operator                      redhat-operators   threescale-2.16
    cert-manager-operator                 openshift-cert-manager-operator       openshift-cert-manager-operator       redhat-operators   stable-v1.18
    openshift-external-secrets-operator   openshift-external-secrets-operator   openshift-external-secrets-operator   redhat-operators   stable-v1
    openshift-logging                     cluster-logging                       cluster-logging                       redhat-operators   stable-6.5

    ---

