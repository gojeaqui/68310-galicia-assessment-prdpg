version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Monitoring & Logging"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Observability"
    - "Security"
  description: "Forward OpenShift application logs to external logging system"
  references: 
  - title: "Forwarding logs to external third-party logging systems"
    url: "https://docs.openshift.com/container-platform/latest/logging/log_collection_forwarding/log-forwarding.html#log-forwarding-about-clf"
  - title: "Understanding cluster logging"
    url: "https://docs.openshift.com/container-platform/latest/logging/cluster-logging.html"
  check_procedures:
    - type: gui_action
      steps: 
      - "verify the object in the UI"
    - type: "survey"
      question: "Does the organization require that application logs are sent to a logging system external to OpenShift?"
    - type: "survey"
      question: "Are app logs being forwarded to an external logging system?"
    - type: "command"
      question: "find out the forwarding configs in openshift-logging namespace"
      command: |
        # 'Review the output under "status" for fluentd pods, logs
        oc get clusterlogging instance -n openshift-logging -o yaml
        oc get clusterlogforwarder -n openshift-logging -o yaml
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "Reenvío de logs configurado únicamente al Loki interno"
    description_long_text: "El reenvío de logs está configurado para la canalización de aplicaciones de OpenShift y se envía únicamente al sistema Loki interno"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "changes_recommended01"
    scenario_description_short_text: "Log forwarding not configured"
    description_long_text: "Log forwarding is not configured for the OpenShift application pipeline to an external logging system"
    impact_and_risk_text: "An external logging system protects the confidentiality, integrity, and availability of application logs"
    remediation_text: "Configure external log forwarding for application logs"
    scenario_description_short_text: "Reenvío de logs configurado hacia un Loki externo"
    description_long_text: "El reenvío de logs está configurado para reenviar los logs"
    impact_and_risk_text: ""
    remediation_text: ""
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: changes_recommended
  common_outcome_key: "changes_recommended01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
