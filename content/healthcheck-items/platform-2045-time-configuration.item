version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Time"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Openshift Cluster Configuration"
  description: "Time Server Configuration"
  references:
  - title: "Configuring chrony time service"
    url: "https://docs.openshift.com/container-platform/latest/installing/install_config/installing-customizing.html#installation-special-config-chrony_installing-customizing"
  check_procedures:
    - type: survey
      question: "What time servers are currently configured in the cluster?"
    - type: survey
      question: "Is chrony service properly configured across all nodes?"
    - type: survey
      question: "Are there any time synchronization issues reported in the cluster?"
    - type: survey
      question: "What is the current time offset between nodes?"
    - type: survey
      question: "Are there any specific time zones requirements for the cluster?"
    - type: survey
      question: "Is there a custom chrony.conf being used via machineConfig?"
    - type: survey
      question: "Are the configured NTP servers accessible from all nodes?"
    - type: survey
      question: "Have there been any time-drift related incidents?"
    - type: command
      command: |
        oc get machineconfig
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "El servicio Chrony está configurado"
      description_long_text: "Se encontró un MachineConfig con la configuración de chrony"  # Consultant to fill out details
      impact_and_risk_text: ""
      remediation_text: ""
    - key: "advisory02"
      scenario_description_short_text: "Time configuration needs monitoring"
      description_long_text: "Time synchronization is functional but requires monitoring"
      impact_and_risk_text: "Potential for minor time drifts"
      remediation_text: "Implement regular monitoring of time synchronization status"
    - key: "no_change01"
      scenario_description_short_text: "La configuración horaria es óptima"
      description_long_text: "El servicio Chrony está configurado correctamente con servidores de hora fiables"
      impact_and_risk_text: "No se han identificado riesgos de sincronización horaria"
      remediation_text: "Continuar con la configuración actual"
    - key: "changes_recommended01"
      scenario_description_short_text: "Time synchronization issues detected"
      description_long_text: "Nodes showing significant time drift or synchronization problems"
      impact_and_risk_text: "Risk of application issues due to time inconsistencies"
      remediation_text: "Review and adjust chrony configuration, verify NTP server accessibility"
    - key: "changes_recommended02"
      scenario_description_short_text: "Time server configuration needs update"
      description_long_text: "Current time servers are not optimal or accessible"
      impact_and_risk_text: "Potential for time synchronization failures"
      remediation_text: "Update chrony configuration with more reliable time servers"
customer_environment_findings:
  status: pass
  common_outcome_key: "advisory01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
