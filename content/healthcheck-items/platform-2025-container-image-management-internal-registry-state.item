    - "Registry"
    - "Openshift Cluster Configuration"
  description: "Openshift internal registry is functioning and running"
  references: 
  - title: "Managing the Openshift internal registry"
    url: "https://docs.openshift.com/container-platform/latest/registry/index.html"
  check_procedures:
    - type: command
      command: | 
        oc get configs.imageregistry.operator.openshift.io cluster -o yaml
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "Registry interna configurada"
    description_long_text: "La Registry interna de OpenShift está funcionando correctamente"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "change01"
    scenario_description_short_text: "La registry interna esta degradada"
    description_long_text: "Se encontró que la registry interna esta degradada por estar en estado 'Managed' pero sin un storage configurado"
    impact_and_risk_text: "La registry interna no puede almacenar ni servir imágenes de contenedor. Esto puede impedir la descarga de imágenes existentes y provocar fallas o interrupciones en nuevos despliegues que dependan de imágenes almacenadas en la registry."
    remediation_text: "Configurar el storage de la registry"
