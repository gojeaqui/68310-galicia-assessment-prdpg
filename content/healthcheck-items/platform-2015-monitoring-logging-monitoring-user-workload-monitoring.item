version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Monitoring & Logging"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Openshift Cluster Configuration"
  description: "User Workload Monitoring"
  references: 
  - title: "Understanding the monitoring stack"
    url: "https://docs.openshift.com/container-platform/latest/monitoring/monitoring-overview.html"
  - title: "Configuring the monitoring stack"
    url: "https://docs.openshift.com/container-platform/latest/monitoring/configuring-the-monitoring-stack.html"
  - title: "Enabling monitoring for user-defined projects"
    url: "https://docs.openshift.com/container-platform/latest/monitoring/enabling-monitoring-for-user-defined-projects.html"
  check_procedures:
    - type: gui_action
      steps: 
      - "verify the object in the UI"
    - type: "command"
      question: ""
      command: |
          # check that cluster-monitoring-config configmap exists
          oc -n openshift-monitoring get configmap cluster-monitoring-config
          oc -n openshift-user-workload-monitoring get pod
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "La monitorización de usuarios está configurada"
    description_long_text: "La monitorización de usuarios está configurada. Los inquilinos pueden ver las métricas gestionadas por RBAC"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "change01"
    scenario_description_short_text: "User monitoring is needed"
    description_long_text: "You can monitor your own projects in OpenShift Container Platform without the need for an additional monitoring solution. Using this feature centralizes monitoring for core platform components and user-defined projects."
    impact_and_risk_text: ""
    remediation_text: ""
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
