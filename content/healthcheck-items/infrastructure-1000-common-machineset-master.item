version: v2
check_definition:
  category_key: "Infrastructure"
  subcategory_key: "Common"
  severity_key: "Not defined"
  tags: []
  description: "Masters Machinesets"
  references: 
  - title: "Getting started with control plane machine sets"
    url: "https://docs.redhat.com/en/documentation/openshift_container_platform/4.16/html/machine_management/managing-control-plane-machines#cpmso-getting-started"
  check_procedures:
    - type: "command"
      command: |
        oc get controlplanemachineset.machine.openshift.io cluster --namespace openshift-machine-api
    - type: "survey"
      question: "Does the cluster have the Control Plane MachineSets created/configured?"
    - type: "survey"
      question: "Was the cluster installed on version prior to Openshift 4.12?"
  common_outcomes:
    - key: "no_change01"
      scenario_description_short_text: "Control Plane MachineSets ya existen"
      description_long_text: "Los Control Plane MachineSets están configurados y gestionados eficazmente."
      impact_and_risk_text: ""
      remediation_text: ""
    - key: "changes_recommended01"
      scenario_description_short_text: "Control Plane MachineSets no creados"
      description_long_text: "Encontramos que los Control Plane MachineSets no existen en el cluster"
      impact_and_risk_text: "Ante la perdida de un nodo master, el mismo se debe recuperar manualmente"
      remediation_text: "Verificar que exista el Operador Cluster Control Plane Machine Set y crear el objecto ControlPlaneMachineSet en base a un MachineSet existente"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: pass
  common_outcome_key: "no_change01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
