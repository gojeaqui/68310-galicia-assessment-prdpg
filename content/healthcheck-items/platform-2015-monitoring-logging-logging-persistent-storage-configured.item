version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Monitoring & Logging"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Observability"
    - "Storage"
  description: "Persistent storage for Logging is appropriate"
  references: 
  - title: "Configuring persistent storage for the log store"
    url: "https://docs.openshift.com/container-platform/latest/observability/logging/log_storage/cluster-logging-loki.html"
  check_procedures:
    - type: gui_action
      steps: 
      - "verify the object in the UI"
    - type: "survey"
      question: "Log store is saved to persistent volumes"
    - type: "survey"
      question: "Log store is not on NFS"
    - type: "survey"
      question: "Is logging using local raw block volumes? If you use a local volume for persistent storage, do not use a raw block volume, which is described with volumeMode: block in the LocalVolume object."
    - type: "survey"
      question: "Is the persistent volume backed by SSD / NVMe devices?"
    - type: "command"
      question: ""
      command: |
          oc get sc
          oc get pvc -n openshift-logging
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: ""
    description_long_text: "Logging has the appropriate type and speed of underlying storage to perform as expected under the current load"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "changes_required01"
    scenario_description_short_text: "El almacenamiento subyacente proporcionado al servicio de Logging no es óptimo"
    description_long_text: "El almacenamiento subyacente proporcionado al despliegue de OpenShift Logging le faltan algunos PVCs de Loki"
    impact_and_risk_text: "Logging requiere almacenamiento persistente. Cuanto más rápido sea el almacenamiento, mejor será el rendimiento de Logging. Se requiere un rendimiento de nivel SSD/NVMe para gestionar las altas necesidades de IOPS de los registros. Algunos tipos de almacenamiento, como NFS o los volúmenes locales de bloques sin formato, pueden provocar falta de fiabilidad y corrupción de datos. No se encontraron PVC para Loki."
    remediation_text: "Configure el almacenamiento persistente de Logging con almacenamiento respaldado por SSD/NVMe y asegúrese de que existan PVC para Loki"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: fail
  common_outcome_key: "changes_required01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
