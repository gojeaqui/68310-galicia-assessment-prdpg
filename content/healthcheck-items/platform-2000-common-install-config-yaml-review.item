  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Install"
  description: "install-config.yaml Configuration"
  references: 
  - title: "Configuring the install-config.yaml file"
    url: "https://docs.openshift.com/container-platform/latest/installing/installing_bare_metal_ipi/ipi-install-installation-workflow.html#additional-resources_config"
  check_procedures:
    - type: command
      command: |
        oc describe cm -n kube-system cluster-config-v1
  common_outcomes:
    - key: "advisory01"
      scenario_description_short_text: "Configuración de 'install-config.yaml' generalmente correcta" 
      description_long_text: "El único problema encontrado con la configuración es el tamaño de los discos de los nodos dado que la recomendación es que sean de 200 GiB"  # Consultant to describe state of install-config
      impact_and_risk_text: "Discos de 120 GiB son suficientes para un clúster estándar con cargas ligeras, pero si se van a utilizar aplicaciones con imágenes grandes se pueden llegar a llenar los nodos"
      remediation_text: "Lo que se puede hacer es recrear el MachineSet de los workers con discos de 200 GiB, en el caso de los masters, 120 GiB esta bien."
