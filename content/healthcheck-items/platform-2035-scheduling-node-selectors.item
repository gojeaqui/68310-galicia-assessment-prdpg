version: v2
check_definition:
  category_key: "Platform"
  subcategory_key: "Project Templating"
  severity_key: "Not defined"
  tags: []
  tag_keys:
    - "Openshift Cluster Configuration"
  description: "Placing pods on specific nodes using node selectors"
  references: 
  - title: "default node selector usage"
    url: "https://docs.openshift.com/container-platform/latest/nodes/scheduling/nodes-scheduler-node-selectors.html"
  check_procedures:
    - type: command
      command: |
        oc get schedulers.config.openshift.io cluster -o yaml
        oc get pods --all-namespaces -o=custom-columns=NAMESPACE:.metadata.namespace,NAME:.metadata.name,STATUS:.status.phase,NODE:.spec.nodeName
  common_outcomes:
  - key: "no_change01"
    scenario_description_short_text: "No se estableció un node selector default"
    description_long_text: "Si bien observamos que no se estableció un node selector default, dado que el cluster no va a estar corriendo aplicaciones diversas no tiene sentido esta recomendación"
    impact_and_risk_text: ""
    remediation_text: ""
  - key: "change01"
    scenario_description_short_text: "No default node selector set"
    description_long_text: "No default nodeSelector has been set, workloads may be ran on non-worker nodes"
    impact_and_risk_text: "Workloads may be ran on non-worker nodes which may consume resources not intended for those workloads"
    remediation_text: "Set a default node selector"
customer_environment_findings:
  # pass, fail, changes_recommended, etc.  See config.yaml for all statuses. 
  status: tbe
  common_outcome_key: "no_change01"
  outcome_overrides:
      scenario_description_short_text: ""
      description_long_text: ""
      impact_and_risk_text: ""
      remediation_text: ""
  additional_comments:
    impact_risk_additional_text: ""
    remediation_additional_text: ""
    additional_comments_text: ""
  outcome_evidence: |
    [guillermo@darkstar paas-apps1-prdpg]$ omc get schedulers.config.openshift.io cluster -o yaml
    apiVersion: config.openshift.io/v1
    kind: Scheduler
    metadata:
      creationTimestamp: "2026-06-30T16:28:31Z"
      generation: 1
      name: cluster
      resourceVersion: "562"
      uid: b5f27f62-b69c-4322-b00d-216df1efba25
    spec:
      mastersSchedulable: false
      policy:
        name: ""
    status: {}

